{
  "name": "tailan-report-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit --incremental false",
    "test": "node --require ./scripts/register-typescript.cjs --test tests/*.test.cjs",
    "migrate:convex": "node --env-file=.env.local scripts/migrate-arcgis-to-convex.cjs",
    "seed:criteria": "node --env-file=.env.local scripts/seed-category-criteria.mjs",
    "fix:signatures": "node --env-file=.env.local scripts/scrub-evaluation-signatures.mjs",
    "fix:locations": "node --env-file=.env.local --require ./scripts/register-typescript.cjs scripts/backfill-locations.cjs",
    "seed:report-types": "node --env-file=.env.local scripts/seed-report-types.mjs",
    "seed:evaluators": "node --env-file=.env.local scripts/seed-evaluators.mjs",
    "seed:plan-criteria": "node --env-file=.env.local scripts/seed-plan-criteria.mjs",
    "setup": "npm run seed:report-types && npm run seed:criteria && npm run seed:plan-criteria",
    "db:backup": "node --env-file=.env.local scripts/backup-databases.cjs",
    "convex:dev": "convex dev",
    "convex:push": "convex dev --once --typecheck enable",
    "convex:deploy": "convex deploy",
    "db:verify": "node --env-file=.env.local scripts/verify-convex.cjs"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "convex": "^1.48.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "16.4.2",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.3",
    "@types/node": "^20.14.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.19",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
