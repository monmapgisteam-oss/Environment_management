# Backend settings. Docker Compose reads them from .env; `npm run dev`
# reads .env.local. The frontend needs none of these.

# Session tokens and signed file links. At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Private ArcGIS feature service that holds the application records and files.
ARCGIS_PORTAL_URL="https://environment.ub.gov.mn/gis"
ARCGIS_DATA_SERVICE_URL="https://environment.ub.gov.mn/hosting/rest/services/Hosted/Tailan/FeatureServer"
# OAuth application credential the backend signs in with.
ARCGIS_CLIENT_ID=""
ARCGIS_CLIENT_SECRET=""
# Sent as Referer when the credential is restricted to the app's address.
ARCGIS_HTTP_REFERER=""

# Service owner token, only for `npm run arcgis:provision` (schema changes),
# which reads .env.local. Docker Compose never passes it to the backend.
ARCGIS_ADMIN_TOKEN=""

# Public address of the site, printed in signature QR codes.
APP_URL="https://your-domain.example"

# Proxies in front of the backend that append to X-Forwarded-For: 1 for the
# Compose nginx alone, 2 with a TLS terminator / load balancer in front of it.
TRUST_PROXY_HOPS=1

# Where Docker Compose publishes the site. Use HTTP_BIND=127.0.0.1 when a TLS
# terminator on the same machine sits in front of it.
HTTP_PORT=8080
HTTP_BIND=0.0.0.0
