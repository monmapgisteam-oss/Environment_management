# Runtime: private ArcGIS application service (never NEXT_PUBLIC_*).
# Filled by arcgis:create; or set the URL of an existing empty private service.
ARCGIS_DATA_SERVICE_URL=""
ARCGIS_DATA_TOKEN=""
# Preferred runtime authentication: renewed server-side before tokens expire.
# When both are set, OAuth takes precedence over ARCGIS_DATA_TOKEN.
ARCGIS_CLIENT_ID=""
ARCGIS_CLIENT_SECRET=""
# Set only when your ArcGIS credential has a Referer restriction.
ARCGIS_HTTP_REFERER=""
JWT_SECRET=""

# Provisioning only. An owner/admin token must allow createService and schema edits.
ARCGIS_PORTAL_URL="https://www.arcgis.com"
ARCGIS_OWNER=""
ARCGIS_ADMIN_TOKEN=""
ARCGIS_SERVICE_NAME="tailan_app"
# Test-only escape hatch. Never enable this outside a disposable service.
ARCGIS_ALLOW_PUBLIC_TEST_SERVICE="false"
# Optional separate OAuth application registered for user authentication.
ARCGIS_OWNER_CLIENT_ID=""
ARCGIS_OWNER_CLIENT_SECRET=""

# Optional first account: npm run arcgis:bootstrap (users table must be empty).
ARCGIS_BOOTSTRAP_EMAIL=""
ARCGIS_BOOTSTRAP_NAME="Administrator"
ARCGIS_BOOTSTRAP_PASSWORD=""

# Survey records (layer 0 and repeat_1) live in the same private service.
ARCGIS_SYNC_DISABLED="false"
