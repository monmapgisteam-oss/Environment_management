# Session and signed file links.
JWT_SECRET=""

# Convex database and file storage. All queries/mutations run server-side.
CONVEX_DEPLOYMENT="dev:hearty-caterpillar-651"
CONVEX_URL="https://hearty-caterpillar-651.convex.cloud"
CONVEX_SITE_URL="https://hearty-caterpillar-651.convex.site"
# At least 32 random characters. Set the same value on the Convex deployment.
# Never expose this through NEXT_PUBLIC_*.
CONVEX_SERVER_SECRET=""
APP_URL=https://your-domain.example
TRUST_PROXY_HOPS=1

# Optional, only when backing up / importing the archived ArcGIS database.
ARCGIS_PORTAL_URL=""
ARCGIS_DATA_SERVICE_URL=""
ARCGIS_CLIENT_ID=""
ARCGIS_CLIENT_SECRET=""
ARCGIS_HTTP_REFERER=""
