# Session and signed file links.
JWT_SECRET=""

# Convex data store (server-side only; never NEXT_PUBLIC_*).
# CONVEX_DEPLOYMENT is written by `npx convex dev` and used by the Convex CLI.
CONVEX_DEPLOYMENT=""
CONVEX_URL=""
# Shared secret between Next.js and Convex. Set the same value with
# `npx convex env set CONVEX_SERVER_SECRET <value>` (32+ characters).
CONVEX_SERVER_SECRET=""

# Set to true to stop mirroring evaluation scores into the survey records.
SURVEY_SYNC_DISABLED="false"

# One-time migration only (npm run migrate:arcgis). Remove after migrating.
ARCGIS_PORTAL_URL=""
ARCGIS_DATA_SERVICE_URL=""
ARCGIS_CLIENT_ID=""
ARCGIS_CLIENT_SECRET=""
ARCGIS_HTTP_REFERER=""
